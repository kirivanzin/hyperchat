.venv/
__pycache__/
*.py[oc]
*.egg-info/
dist/
build/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Terraform state is local and never belongs in a repository. `terraform init` also writes
# .terraform/, and a .tfvars carries the project id, which is the one identifier this repository
# deliberately does not contain.
.terraform/
*.tfstate
*.tfstate.*
crash.log
terraform.tfvars

# Secrets and keys: none exist yet, and these are here so the day one appears it is not committed
# by accident.
*.env
*.env.*
!.env.example
*.pem
*.key

# Anything kept locally that is not for publication: the contributor's account details, notes
# about this machine, tricks that only make sense here. Never committed, and never needed to
# build the project -- if the repository stops working without something, that something belongs in
# the repository.
.secret/

# Belt as well as braces: the identity file must never be public even if it is moved out of .secret/,
# and it once sat in the repository root untracked and one `git add -A` from being published.
.agent.identity

# Instructions for whoever is working in a checkout, which are not the project's instructions.
# Named here as well as in .git/info/exclude: the local file does not travel, so a fresh clone or a
# colleague's checkout would otherwise have no protection at all.
AGENTS.md

.DS_Store
.zed/

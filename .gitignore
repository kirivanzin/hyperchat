.venv/
__pycache__/
*.py[oc]
*.egg-info/
dist/
build/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Terraform state is local and never belongs in a repository. `terraform init` also writes
# .terraform/, and a .tfvars carries the project id, which is the one identifier this repository
# deliberately does not contain.
.terraform/
*.tfstate
*.tfstate.*
crash.log
terraform.tfvars

# Secrets and keys: none exist yet, and these are here so the day one appears it is not committed
# by accident.
*.env
*.env.*
!.env.example
*.pem
*.key

.DS_Store
.zed/

# The agent's own account details, as returned by `gh api /user`, plus its public key. Not a
# credential, but it is a file about an identity that has no business in a public repository --
# and the filename below is misspelled because that is the name on disk. Both spellings are here so
# renaming it later does not quietly start publishing it.
.agent.idenity
.agent.identity

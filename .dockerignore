# The build context. Everything here is either a secret, a local artefact, or infra that has no
# business inside a container. README.md is deliberately NOT excluded: pyproject.toml declares
# readme = "README.md" and the build backend reads it while installing the package.
.venv
.git
.gitignore
.gitattributes
__pycache__
*.py[oc]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.coverage.*
htmlcov
terraform/
scripts/
.secret/
.agent.identity
AGENTS.md
tests/
evals/
# The four documents the agent reads are the exception, and they are named rather than the whole
# directory: the context is what the `COPY` lines can see, so excluding `docs/` outright would leave
# the corpus out of the image and the failure would only appear in the deploy.
docs/*
!docs/authentication.md
!docs/repository-as-code.md
!docs/contributor.md
*.env
*.env.*
*.pem
*.key
*.tfstate
*.tfstate.*
Makefile
Dockerfile
.dockerignore
